# Everything runs with zero configuration: mock AI provider, SQLite file DB.
# Copy to .env only if you want to change defaults.

# --- Server ---
PORT=4100
# DB_PATH=data/engine.db
# API_KEY=            # set to require Authorization: Bearer <key> on the API

# --- AI (optional — leave empty for the $0 grounded mock provider) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5        # L2 small model (classification)
# ANTHROPIC_SMART_MODEL=claude-sonnet-5   # L3 large model (reasoning)

# --- Cost governance ---
# AI_MONTHLY_BUDGET_USD=15

# --- Automations (optional) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- Live connector extras (optional) ---
# GITHUB_REPO=owner/repo   # pull real public stargazers instead of the fixture
